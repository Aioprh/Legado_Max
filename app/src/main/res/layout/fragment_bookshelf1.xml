<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:attachToActivity="false"
        app:title="@string/bookshelf" />

    <!--
        书架筛选标签统一由每个 BooksFragment 的 SmartTagFilterBar 提供。
        这里保留旧 tag_bar 仅用于兼容现有 ViewBinding/代码，实际不占布局空间，
        避免左右滑动切换分组时出现第二套“全部/听书”等重复标签。
    -->
    <io.legado.app.ui.widget.RoundedTagBarView
        android:id="@+id/tag_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <io.legado.app.ui.widget.BookshelfRefreshLayout
        android:id="@+id/refresh_layout_bookshelf"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager_bookshelf"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </io.legado.app.ui.widget.BookshelfRefreshLayout>

</LinearLayout>