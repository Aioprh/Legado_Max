<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">

    <!-- 顶部沉浸式封面区：模糊封面 + 上下渐隐，替代旧版硬边弧形 -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="420dp" app:layout_constraintTop_toTopOf="parent">
        <ImageView android:id="@+id/bg_book" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/bg_image" android:scaleType="centerCrop" />
        <View android:layout_width="match_parent" android:layout_height="150dp" android:background="@drawable/bg_scrim_top" />
        <View android:layout_width="match_parent" android:layout_height="210dp" android:layout_gravity="bottom" android:background="@drawable/bg_scrim_bottom" />
    </FrameLayout>

    <LinearLayout android:id="@+id/vw_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <io.legado.app.ui.widget.TitleBar android:id="@+id/title_bar" android:layout_width="match_parent" android:layout_height="wrap_content" app:themeMode="dark" app:title="@string/book_info" />
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/refresh_layout" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <io.legado.app.ui.widget.NoChildScrollNestedScrollView android:id="@+id/scroll_view" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:fillViewport="true" android:fitsSystemWindows="false" android:scrollbarStyle="outsideOverlay" android:scrollbars="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:orientation="vertical" android:paddingBottom="24dp">

                    <!-- 封面 -->
                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="22dp">
                        <androidx.cardview.widget.CardView android:id="@+id/iv_cover_c" android:layout_width="132dp" android:layout_height="188dp" android:layout_gravity="center_horizontal" app:cardCornerRadius="16dp" app:cardElevation="10dp" app:cardPreventCornerOverlap="true">
                            <io.legado.app.ui.widget.image.CoverImageView android:id="@+id/iv_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/img_cover" android:scaleType="centerCrop" android:src="@drawable/image_cover_default" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <LinearLayout android:id="@+id/ll_content_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp">

                        <!-- 书籍信息卡 -->
                        <LinearLayout android:id="@+id/ll_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_book_info_card" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="18dp" android:paddingEnd="18dp" android:paddingBottom="10dp">

                            <TextView android:id="@+id/tv_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:maxLines="2" android:text="@string/book_name" android:textColor="@color/primaryText" android:textSize="22sp" android:textStyle="bold" />

                            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:overScrollMode="never" android:scrollbars="none">
                                <io.legado.app.ui.widget.LabelsBar android:id="@+id/lb_kind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
                            </HorizontalScrollView>

                            <!-- 阅读进度 -->
                            <LinearLayout android:id="@+id/ll_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/book_info_progress_title" android:textColor="@color/tv_text_summary" android:textSize="13sp" />
                                    <TextView android:id="@+id/tv_progress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/primaryText" android:textSize="13sp" />
                                </LinearLayout>
                                <ProgressBar android:id="@+id/pb_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="9dp" android:max="100" android:progress="0" android:progressBackgroundTint="@color/border_card_surface" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/border_card_surface" />

                            <!-- 作者 -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_author" app:tint="@color/tv_text_summary" />
                                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/book_info_label_author" android:textColor="@color/tv_text_summary" android:textSize="13sp" />
                                <TextView android:id="@+id/tv_author" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:text="@string/author" android:textColor="@color/primaryText" android:textSize="14sp" />
                            </LinearLayout>

                            <!-- 来源 -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:id="@+id/iv_web" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_web_outline" app:tint="@color/tv_text_summary" />
                                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/book_info_label_origin" android:textColor="@color/tv_text_summary" android:textSize="13sp" />
                                <TextView android:id="@+id/tv_origin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="@color/primaryText" android:textSize="14sp" />
                                <io.legado.app.ui.widget.text.AccentStrokeTextView android:id="@+id/tv_change_source" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/change_origin" android:textSize="12sp" app:radius="10dp" />
                            </LinearLayout>

                            <!-- 最新章节 -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:id="@+id/ic_book_last" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_book_last" app:tint="@color/tv_text_summary" />
                                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/book_info_label_latest" android:textColor="@color/tv_text_summary" android:textSize="13sp" />
                                <TextView android:id="@+id/tv_lasted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="@color/primaryText" android:textSize="14sp" />
                            </LinearLayout>

                            <!-- 分组 -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_groups" app:tint="@color/tv_text_summary" />
                                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/book_info_label_group" android:textColor="@color/tv_text_summary" android:textSize="13sp" />
                                <TextView android:id="@+id/tv_group" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="@color/primaryText" android:textSize="14sp" />
                                <io.legado.app.ui.widget.text.AccentStrokeTextView android:id="@+id/tv_change_group" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/change_group" android:textSize="12sp" app:radius="10dp" />
                            </LinearLayout>

                            <!-- 目录 -->
                            <LinearLayout android:id="@+id/ll_toc" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_folder_open" app:tint="@color/tv_text_summary" />
                                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/book_info_label_toc" android:textColor="@color/tv_text_summary" android:textSize="13sp" />
                                <TextView android:id="@+id/tv_toc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="@color/primaryText" android:textSize="14sp" />
                                <io.legado.app.ui.widget.text.AccentStrokeTextView android:id="@+id/tv_toc_view" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/view_toc" android:textSize="12sp" app:radius="10dp" />
                            </LinearLayout>

                            <!-- 阅读记录 -->
                            <LinearLayout android:id="@+id/ll_read_record" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_history" app:tint="@color/tv_text_summary" />
                                <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/book_info_label_read" android:textColor="@color/tv_text_summary" android:textSize="13sp" />
                                <TextView android:id="@+id/tv_read_record" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="@color/primaryText" android:textSize="14sp" />
                                <io.legado.app.ui.widget.text.AccentStrokeTextView android:id="@+id/tv_read_record_view" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/view_read_record" android:textSize="12sp" app:radius="10dp" />
                            </LinearLayout>

                            <LinearLayout android:id="@+id/ll_read_record_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="30dp" android:visibility="gone" />
                        </LinearLayout>

                        <!-- 简介 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_book_info_card" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="16dp" android:paddingEnd="18dp" android:paddingBottom="16dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/book_info_intro" android:textColor="@color/primaryText" android:textSize="16sp" android:textStyle="bold" />
                            <FrameLayout android:id="@+id/tv_intro_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" />
                        </LinearLayout>

                        <!-- 作者其他作品 -->
                        <LinearLayout android:id="@+id/ll_author_other_works" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_book_info_card" android:orientation="vertical" android:paddingStart="0dp" android:paddingTop="14dp" android:paddingEnd="0dp" android:paddingBottom="8dp" android:visibility="gone">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="12dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/book_info_author_other_works" android:textColor="@color/primaryText" android:textSize="16sp" android:textStyle="bold" />
                                <ImageView android:id="@+id/iv_author_other_works_refresh" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/refresh" android:padding="7dp" android:src="@drawable/ic_refresh_black_24dp" app:tint="@color/tv_text_summary" />
                            </LinearLayout>
                            <TextView android:id="@+id/tv_author_other_works_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:textColor="@color/tv_text_summary" android:textSize="13sp" android:visibility="gone" />
                            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_author_other_works" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:clipToPadding="false" android:visibility="gone" tools:itemCount="2" tools:listitem="@layout/item_search" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </io.legado.app.ui.widget.NoChildScrollNestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 悬浮操作栏 -->
        <FrameLayout android:id="@+id/fl_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_scrim_bottom" android:clipChildren="false" android:clipToPadding="false" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/bg_book_action_dock" android:clipChildren="false" android:elevation="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/tv_shelf" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_btn_secondary" android:gravity="center" android:text="@string/add_to_bookshelf" android:textColor="@color/primaryText" android:textSize="15sp" />
                <io.legado.app.ui.widget.text.AccentBgTextView android:id="@+id/tv_read" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:gravity="center" android:text="@string/reading" android:textSize="15sp" app:radius="14dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
