<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:displayHomeAsUp="true"
        app:title="@string/ai_generate_book_source" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="104dp">

                <!-- ① AI 服务 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_form_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ai_section_service"
                            android:textColor="@color/secondaryText"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_ai_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_service_unconfigured"
                            android:textColor="@color/secondaryText"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ai_base_url_hint">

                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/et_base_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ai_api_key_hint">

                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/et_api_key"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ai_model_hint">

                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/et_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_model_preset_hint"
                            android:textColor="@color/secondaryText"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/sp_model_preset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:entries="@array/ai_model_presets"
                            android:theme="@style/Spinner"
                            tools:ignore="TouchTargetSizeCheck" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ② 目标站点 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_form_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp"
                        android:text="@string/ai_section_site"
                        android:textColor="@color/secondaryText"
                        android:textSize="12sp" />

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ai_url_hint">

                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/et_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ai_keyword_hint">

                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/et_keyword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/book_type"
                            android:textColor="@color/secondaryText"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/sp_type"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:entries="@array/book_type"
                            android:theme="@style/Spinner"
                            tools:ignore="TouchTargetSizeCheck" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ai_review_probe"
                            android:textColor="@color/primaryText"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_review_probe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_more_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="4dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="10dp"
                        android:text="@string/ai_more_toggle"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/ll_more"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <io.legado.app.ui.widget.text.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/ai_header_hint">

                            <io.legado.app.lib.theme.view.ThemeEditText
                                android:id="@+id/et_header"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:maxLines="3"
                                android:minLines="1" />
                        </io.legado.app.ui.widget.text.TextInputLayout>

                        <io.legado.app.ui.widget.text.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/ai_cookie_hint">

                            <io.legado.app.lib.theme.view.ThemeEditText
                                android:id="@+id/et_cookie"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:maxLines="2"
                                android:minLines="1" />
                        </io.legado.app.ui.widget.text.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- ③ 生成与校验 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_form_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp"
                        android:text="@string/ai_section_generate"
                        android:textColor="@color/secondaryText"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_fetch_html"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_secondary"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@null"
                            android:text="@string/ai_fetch_html"
                            android:textAllCaps="false"
                            android:textColor="@color/primaryText"
                            android:textSize="13.5sp" />

                        <Button
                            android:id="@+id/btn_generate"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_primary"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@null"
                            android:text="@string/ai_generate"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="4dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/secondaryText"
                        android:textSize="12.5sp" />

                    <io.legado.app.ui.widget.text.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="@string/ai_result_hint">

                        <io.legado.app.lib.theme.view.ThemeEditText
                            android:id="@+id/et_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLines="10"
                            android:minLines="6"
                            android:saveEnabled="false"
                            android:scrollbars="vertical" />
                    </io.legado.app.ui.widget.text.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_validate"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_secondary"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@null"
                            android:text="@string/ai_validate"
                            android:textAllCaps="false"
                            android:textColor="@color/primaryText"
                            android:textSize="13.5sp" />

                        <Button
                            android:id="@+id/btn_auto_fix"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_secondary"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@null"
                            android:text="@string/ai_auto_fix"
                            android:textAllCaps="false"
                            android:textColor="@color/primaryText"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_checks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="4dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/primaryText"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_html_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="4dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="6dp"
                        android:text="@string/ai_html_toggle"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/ll_html"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_html_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <io.legado.app.ui.widget.text.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/ai_html_preview_hint">

                            <io.legado.app.lib.theme.view.ThemeEditText
                                android:id="@+id/et_html_preview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:maxLines="6"
                                android:minLines="3"
                                android:saveEnabled="false"
                                android:scrollbars="vertical" />
                        </io.legado.app.ui.widget.text.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_action_bar"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:text="@string/ai_clear"
                android:textAllCaps="false"
                android:textColor="@color/primaryText"
                android:textSize="13.5sp" />

            <Button
                android:id="@+id/btn_import"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="2"
                android:background="@drawable/bg_btn_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:text="@string/ai_import_editor"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13.5sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
