<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="112dp"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <io.legado.app.ui.widget.image.CoverImageView
        android:id="@+id/iv_cover"
        android:layout_width="64dp"
        android:layout_height="88dp"
        android:contentDescription="@string/img_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/image_cover_default"
        android:transitionName="img_cover"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_right_actions"
        android:layout_width="48dp"
        android:layout_height="88dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_name"
        app:layout_constraintTop_toTopOf="@id/iv_cover">

        <FrameLayout
            android:id="@+id/fl_has_new"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:gravity="center">
            <io.legado.app.ui.widget.text.BadgeView
                android:id="@+id/bv_unread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false" />
            <io.legado.app.ui.widget.anima.RotateLoading
                android:id="@+id/rl_loading"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:visibility="invisible"
                app:loading_width="2dp" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/iv_audio_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="播放"
            android:padding="10dp"
            android:src="@drawable/ic_play_24dp"
            android:tint="@color/tv_text_summary"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/primaryText"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/ll_right_actions"
        app:layout_constraintStart_toEndOf="@id/iv_cover"
        app:layout_constraintTop_toTopOf="@id/iv_cover" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_author"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:padding="1dp"
        android:src="@drawable/ic_author"
        app:layout_constraintStart_toStartOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        app:tint="@color/tv_text_summary" />

    <TextView
        android:id="@+id/tv_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/tv_text_summary"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/tv_last_update_time"
        app:layout_constraintStart_toEndOf="@id/iv_author"
        app:layout_constraintTop_toTopOf="@id/iv_author" />

    <TextView
        android:id="@+id/tv_last_update_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/tv_text_summary"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_author"
        app:layout_constraintEnd_toEndOf="@id/tv_name" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_read"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="5dp"
        android:padding="1dp"
        android:src="@drawable/ic_history"
        app:layout_constraintStart_toStartOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/tv_author"
        app:tint="@color/tv_text_summary" />

    <TextView
        android:id="@+id/tv_read"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/tv_text_summary"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/ll_right_actions"
        app:layout_constraintStart_toEndOf="@id/iv_read"
        app:layout_constraintTop_toTopOf="@id/iv_read" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_last"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="5dp"
        android:padding="1dp"
        android:src="@drawable/ic_book_last"
        app:layout_constraintStart_toStartOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/tv_read"
        app:tint="@color/tv_text_summary" />

    <TextView
        android:id="@+id/tv_last"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/tv_text_summary"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/ll_right_actions"
        app:layout_constraintStart_toEndOf="@id/iv_last"
        app:layout_constraintTop_toTopOf="@id/iv_last" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_read_progress"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="5dp"
        android:visibility="gone"
        app:indicatorCornerRadius="2dp"
        app:trackThickness="3dp"
        app:layout_constraintEnd_toStartOf="@id/ll_right_actions"
        app:layout_constraintStart_toStartOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/tv_last" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flexbox_tags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:alignContent="flex_start"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toStartOf="@id/ll_right_actions"
        app:layout_constraintStart_toStartOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/pb_read_progress" />

    <TextView
        android:id="@+id/tv_intro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/tv_text_summary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/ll_right_actions"
        app:layout_constraintStart_toStartOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/flexbox_tags" />

</androidx.constraintlayout.widget.ConstraintLayout>
