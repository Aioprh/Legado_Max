<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_chapter_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_toc_item"
    android:minHeight="64dp"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/view_current_indicator"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:background="@color/accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_volume_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="5dp"
        android:padding="3dp"
        android:src="@drawable/ic_arrow_right_fill"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_locked"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:layout_marginEnd="7dp"
        android:padding="2dp"
        android:src="@drawable/ic_lock_outline"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_volume_indicator"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/secondaryText"
        tools:ignore="HardcodedText,RtlSymmetry"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_chapter_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textSize="16sp"
        android:textStyle="normal"
        app:layout_constraintBottom_toTopOf="@id/barrier"
        app:layout_constraintEnd_toStartOf="@id/iv_checked"
        app:layout_constraintStart_toEndOf="@id/iv_locked"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="第1章 永夜" />

    <TextView
        android:id="@+id/tv_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_toc_tag"
        android:ellipsize="end"
        android:maxWidth="180dp"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/secondaryText"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_word_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/iv_locked"
        app:layout_constraintTop_toBottomOf="@id/barrier"
        tools:text="2024-09-06 09:47"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_word_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:singleLine="true"
        android:textColor="@color/secondaryText"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_checked"
        app:layout_constraintStart_toEndOf="@id/tv_tag"
        app:layout_constraintTop_toBottomOf="@id/barrier"
        tools:text="2507字"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="tv_word_count,tv_tag" />

    <ImageView
        android:id="@+id/iv_checked"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/success"
        android:padding="5dp"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/secondaryText"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
