<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_chapter_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="1dp"
    android:background="@drawable/bg_toc_item"
    android:minHeight="54dp"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/view_current_indicator"
        android:layout_width="3dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_toc_item_current"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_volume_indicator"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="expand/collapse"
        android:src="@drawable/ic_arrow_right_fill"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_current_indicator"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_locked"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="7dp"
        android:contentDescription="vip"
        android:padding="2dp"
        android:src="@drawable/ic_lock_outline"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_volume_indicator"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/secondaryText"
        tools:ignore="HardcodedText,RtlSymmetry"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_chapter_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/barrier"
        app:layout_constraintEnd_toStartOf="@id/iv_checked"
        app:layout_constraintStart_toEndOf="@id/iv_locked"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="第一章 一个很长的章节标题" />

    <TextView
        android:id="@+id/tv_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_toc_tag"
        android:ellipsize="end"
        android:maxWidth="160dp"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/secondaryText"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_word_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/iv_locked"
        app:layout_constraintTop_toBottomOf="@id/barrier"
        tools:text="更新时间"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_word_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:singleLine="true"
        android:textColor="@color/secondaryText"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_checked"
        app:layout_constraintStart_toEndOf="@id/tv_tag"
        app:layout_constraintTop_toBottomOf="@id/barrier"
        tools:text="10字"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="tv_word_count,tv_tag" />

    <ImageView
        android:id="@+id/iv_checked"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@string/success"
        android:padding="5dp"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/secondaryText"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
