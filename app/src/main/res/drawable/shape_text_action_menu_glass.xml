<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 液态玻璃主体：半透明冷白底 + 柔和高光 -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/glass_bar" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="50%p">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/glass_highlight" />
        </shape>
    </item>
</layer-list>
