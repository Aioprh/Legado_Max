<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="@color/glass_card_shadow" />
                </shape>
            </item>
            <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient android:angle="270" android:startColor="@color/glass_card_pressed_start" android:centerColor="@color/glass_card_pressed_center" android:endColor="@color/glass_card_pressed_end" />
                    <stroke android:width="1dp" android:color="@color/glass_card_stroke_strong" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="21dp" />
                    <gradient android:angle="270" android:startColor="@color/glass_card_highlight" android:centerColor="@color/transparent" android:endColor="@color/glass_card_bottom_tint" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
                <shape android:shape="rectangle"><corners android:radius="22dp" /><solid android:color="@color/glass_card_shadow" /></shape>
            </item>
            <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient android:angle="270" android:startColor="@color/glass_card_focus_start" android:centerColor="@color/glass_card_focus_center" android:endColor="@color/glass_card_focus_end" />
                    <stroke android:width="1dp" android:color="@color/glass_card_stroke_strong" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="@color/glass_card_shadow" />
                </shape>
            </item>
            <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient android:angle="270" android:startColor="@color/glass_card_start" android:centerColor="@color/glass_card_center" android:endColor="@color/glass_card_end" />
                    <stroke android:width="1dp" android:color="@color/glass_card_stroke" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="21dp" />
                    <gradient android:angle="270" android:startColor="@color/glass_card_highlight" android:centerColor="@color/transparent" android:endColor="@color/glass_card_bottom_tint" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
