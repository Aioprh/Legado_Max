<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D4FFFFFF" android:endColor="#82CFE0EA" android:type="linear" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#70FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#B8F8FCFF" android:endColor="#5FCFE0EA" android:type="linear" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#52FFFFFF" />
        </shape>
    </item>
</selector>