<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
            <gradient android:angle="270"
                android:startColor="@color/glass_title_start"
                android:centerColor="@color/glass_title_center"
                android:endColor="@color/glass_title_end" />
            <stroke android:width="1dp" android:color="@color/glass_title_stroke" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="23dp" android:bottomRightRadius="23dp" />
            <gradient android:angle="270"
                android:startColor="@color/glass_title_highlight"
                android:centerColor="@color/transparent"
                android:endColor="@color/transparent" />
        </shape>
    </item>
</layer-list>
