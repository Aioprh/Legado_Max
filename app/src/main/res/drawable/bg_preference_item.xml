<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D4FFFFFF" android:endColor="#82DCE3EA" android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#BDFBFCFE" android:endColor="#66E8EDF2" android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#42FFFFFF" />
        </shape>
    </item>
</selector>