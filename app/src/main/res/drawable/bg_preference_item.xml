<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_card_pressed_start" android:endColor="@color/glass_card_pressed_end" android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/glass_card_stroke_strong" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_card_focus_start" android:endColor="@color/glass_card_focus_end" android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/glass_card_stroke_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_card_start" android:endColor="@color/glass_card_end" android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/glass_card_stroke" />
        </shape>
    </item>
</selector>