9630928000,"BookPartInfo":{"Position":0,"BookPartList":[]},"JoinTimeCopyRight":"2025年6月11日上架","IsDoubleTicket":0},"BookDetailBurid":{"BookDetailTag":"bookdetailTag","UpdateNumbers":"updatenumbers","CategoryRank":"categoryrank","OutSideRole":"outsiderole","Abctest":"c","BookHonor":"bookhonor"},"CircleSwitch":1,"FansClubBookInfo":{"CanJoin":0,"HasJoin":0,"FansClubBook":0},"BookCircleScope":{"BookForumNew":0,"AllowSetParagraphReviewSelfSee":0,"TotalFansCount":79799,"BookForumCount":378,"AllowSetChapterReviewSelfSee":0,"BookCircleDetail":[{"CircleId":32953022707873909,"PostType":1,"UserName":"西门要吹雪","CircleReviewDesc":"三体原著中，智子除了锁死对撞机外，也就只剩下监视和搞鬼的能力（宇宙闪烁），几乎没有杀伤力。但实际上，我认为智子本身就是毁灭性武器，利用的好可以轻松毁灭地球。比如：智子在太阳背面展开，形成巨大的抛物面，利用其全镜面反射聚焦太阳光，投射到地球上。当光斑直接小于10公里时，能量密度≈太阳自然光照的500万倍，相当于每平方米承受650万吨TNT当量/秒。光斑照射下，可以在0.1秒内升温至10万℃以上，地表全部都要等离子化。大家可以畅想下，智子还能怎么用。","IsJINGHUA":1,"UserId":0,"Title":"讨论贴：智子N种毁灭地球的办法。","HeadIcon":"https://ccportrait.yuewen.com/apimg/349573/p_17620766806803201/100","PostId":1165411089551982592},{"CircleId":32953022707873909,"PostType":5000,"UserName":"痕久小子","CircleReviewDesc":"地球被三体发现是迟早的事，而主角要做的就是推迟地球暴露的时间，好了主角推动主线剧情动机有了。第一，主角能穿越世界，在三体世界人身安全。如果告知国家三体人的事情，不一定信你，而且自己也不能随便暴露穿越的秘密，所以主角第一行为逻辑是靠自己的外挂独自解决问题。第二，主角明白阻止了一个叶，还会有其他人，地球对外探索是不会停止。因此主角要做的就是监控整个地球，将对宇宙的探索掌控在自己手里。第三，主角靠其他世界资源，建立一个跨国巨企，暗中派遣部队去各国破坏阻止个人组织或国家对外太空有可能暴露地球坐标的项目（正常航天项目肯定可以）。然后再安排伊文斯得知不明势力破坏各国对地外文明的探索可能与外星人有关，最后向三体人暴露位置。矛盾也有了，这阶段就是主角建势力穿越获取其他世界资源，不但与三体世界各势力斗，有与各个其他世界的势力斗。第四，到新世纪，由于斗了这么久，各国高层多少也明白是主角在搞破坏，而且目的是阻止人类对外发射信号，并且隐隐察觉太阳系内的异样极大可能与主角有关。然后主角势力差不多要摊牌到明面上，然后就是和三体对决了，这里剧情也差不多大结局了","IsJINGHUA":1,"UserId":0,"Title":"还没看书，看到有人吐槽强行让叶文洁推动剧情，说说我想的主线点子","HeadIcon":"https://me.qidian.com/Images/UserImages/100x100/272.jpg","PostId":1162095173938642944},{"CircleId":32953022707873909,"PostImage":"https://qdreaderpic-1252317822.file.myqcloud.com/25783778/c93f7f49a0da4752aa0e3ced57a105e3_original.jpg","PostType":5000,"UserName":"惊世之声","CircleReviewDesc":"给个精不？","IsJINGHUA":1,"UserId":0,"Title":"","HeadIcon":"https:/